# .env.example — скопируйте в .env и впишите реальные значения.
# .env НЕ должен попадать в git — добавьте его в .gitignore.

# --- EVM (Blockscout Pro API) ---
BLOCKSCOUT_API_KEY=proapi_ваш_реальный_ключ

# --- TRON (когда будет tron_adapter) ---
TRONGRID_API_KEY=

# --- BTC / доп. источники (когда понадобятся) ---
BLOCKCHAIR_API_KEY=

# --- Attribution / санкции ---
# OFAC — бесплатно, без ключа (bulk XML).
# GoPlus — бесплатный тир без ключа, ключ только повышает лимиты.
# OpenSanctions — ОСНОВНОЙ путь (bulk targets.nested.json) тоже бесплатный,
# без ключа. OPENSANCTIONS_API_KEY нужен ТОЛЬКО для опционального живого
# /match-резерва (attribution.opensanctions.check_address_opensanctions,
# сейчас нигде не вызывается из основного графа) — платный, 0.10 EUR/запрос
# сверх 50 бесплатных/мес. Без ключа этот резерв просто тихо пропускается.
GOPLUS_API_KEY=
OPENSANCTIONS_API_KEY=

# --- Flow & Hop Tracer (резолв свопов через известные DEX) ---
# TheGraph decentralized network — ключ создаётся в Subgraph Studio
# (thegraph.com/studio), ДЛЯ ЭТОГО НУЖЕН Web3-кошелёк (MetaMask и т.п.), в
# отличие от остальных ключей в этом файле. Бесплатный тир — 100k запросов/мес.
# Без ключа своп-резолв просто не работает (resolve_swap вернёт None), обычный
# transfer-трейсинг (без свопов) на это не завязан.
THEGRAPH_API_KEY=

# --- Ollama ---
# Внутри docker-compose сети — имя сервиса, не localhost
OLLAMA_HOST=http://ollama:11434
ORCHESTRATOR_MODEL=qwen3-coder

# --- PostgreSQL (evidence log, Seed Registry, label cache, вердикты) ---
# Для docker-compose пароль обычно идёт через Docker secret (POSTGRES_PASSWORD_FILE),
# см. docker-compose.yml. Для локального запуска без докера можно просто:
POSTGRES_DSN=postgresql://aml_platform:пароль@localhost:5432/aml_platform
