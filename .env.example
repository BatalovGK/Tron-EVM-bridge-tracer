# .env.example — скопируйте в .env и впишите реальный ключ.
# .env НЕ должен попадать в git (см. .gitignore — уже настроено).
#
# Область: bridge_tracer.py / layerzero_tracer.py / usdt0_deployments.py и
# сетевые адаптеры, от которых они зависят (aml/evm_adapter, aml/tron_adapter).

# --- Обязательно: Blockscout Pro API (пост-bridge обход на EVM-сети) ---
# Без этого ключа evm_adapter.get_token_transfers() не сможет обратиться к
# Blockscout Pro — bridge_tracer.py упадёт с SecretNotFoundError на шаге
# пост-bridge обхода (шаги 1-2 через LayerZero Scan ключа не требуют).
BLOCKSCOUT_API_KEY=proapi_ваш_реальный_ключ

# --- Рекомендуется: TronGrid API (ОСНОВНОЙ путь детекции депозита) ---
# TronGrid работает и без ключа (публичный тир, просто более низкий
# троттлинг — официальная документация TronGrid не публикует точные цифры
# лимитов, developers.tron.network/reference/rate-limits). Без ключа
# bridge_tracer.py не упадёт — TronGrid-путь (bridge_registry.py) просто
# будет медленнее; при недоступности TronGrid трейсер автоматически
# переключается на fallback через LayerZero Scan messages/wallet (не
# требует ключа вовсе).
TRONGRID_API_KEY=
